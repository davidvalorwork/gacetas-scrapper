# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=gacetas_db
MONGO_COLLECTION_NAME=gacetas

# Tesseract Configuration (opcional, solo si Tesseract no está en PATH)
# TESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe

# Tessdata directory (necesario en Windows si falla "spa.traineddata")
# Debe ser la carpeta "tessdata" donde están los .traineddata (ej. ...\\Tesseract-OCR\\tessdata)
# TESSDATA_PREFIX=C:\\Program Files\\Tesseract-OCR\\tessdata

# ===========================================================
# OpenRouter (scripts/extract_personas_llm.py)
# ===========================================================
# REQUERIDO: API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo. Recomendado un modelo con contexto largo para batchar paginas.
# Ej: google/gemini-2.5-pro (~1M ctx), anthropic/claude-opus-4.6 (~200K),
#     openai/gpt-4.1 (~1M), deepseek/deepseek-chat-v3 (~128K), etc.
OPENROUTER_MODEL=google/gemini-2.5-pro

# Presupuesto de tokens de ENTRADA por llamada. Subelo si tu modelo lo permite.
# Default 200000. Para gemini-2.5-pro puedes subirlo a 900000.
OPENROUTER_MAX_CTX_TOKENS=200000

# Tope de tokens de SALIDA por llamada (JSON con personas). Default 8000.
OPENROUTER_MAX_OUTPUT_TOKENS=8000

# Timeout de cada request HTTP a OpenRouter (segundos).
OPENROUTER_TIMEOUT_S=300

# Pausa entre llamadas para evitar rate limit (segundos, puede ser decimal).
OPENROUTER_DELAY_S=1.0

# (Opcional) Analytics de OpenRouter. No afectan el comportamiento.
OPENROUTER_SITE_URL=https://github.com/tu-usuario/gacetas-scrapper
OPENROUTER_APP_NAME=gacetas-extractor

# (Opcional) Base URL alterna (proxy / gateway). Default oficial.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
